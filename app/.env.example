# Copy to .env (gitignored) and fill in from the Supabase project dashboard
# (Project Settings -> API). The anon/publishable key is safe to expose in a
# client bundle by design — it identifies the project, not a secret; every
# table it can reach is still gated by row-level security.
VITE_SUPABASE_URL=https://vhaynkgnqcbejiojvujg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_AHV6lLY8uKIGxlO8a8C21Q_k2a1iwUU

# Health Sync (Google Health API — Fitbit / Pixel Watch data). The OAuth
# Client ID from Google Cloud Console (APIs & Services -> Credentials). Safe
# to expose in a client bundle, same reasoning as the Supabase key above — a
# Client ID is not a secret, it just identifies the app to Google's consent
# screen. The matching Client Secret is NEVER set here — it lives only as
# the `GOOGLE_HEALTH_CLIENT_SECRET` Supabase Edge Function secret
# (`supabase secrets set`), read solely by health-sync-oauth-callback /
# health-sync-sync, never shipped to the browser. Those two functions also
# need their own `GOOGLE_HEALTH_CLIENT_ID` Edge Function secret (same value
# as below) since Edge Functions don't read Vite's `VITE_*` env.
VITE_GOOGLE_HEALTH_CLIENT_ID=
